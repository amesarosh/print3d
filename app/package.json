{
  "name": "print3d-studio",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop app for designing 3D-print parts with the Claude Agent SDK",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node build.mjs && electron . --no-sandbox",
    "dist": "node build.mjs && electron-builder --linux deb"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  },
  "author": "Alex Mesarosh <alex@amesaro.sh>",
  "build": {
    "appId": "dev.uaio.print3d-studio",
    "productName": "Print3D Studio",
    "executableName": "print3d-studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*-musl/**"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "synopsis": "Design 3D-print parts with Claude",
      "desktop": {
        "entry": {
          "StartupWMClass": "Print3D Studio"
        }
      }
    },
    "deb": {
      "packageName": "print3d-studio"
    }
  },
  "homepage": "https://amesaro.sh/projects/print3d"
}
